{
  "name": "yigate-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node scripts/check-source.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "update:deps": "npx taze -r -w"
  },
  "dependencies": {
    "antdv-next": "^1.8.1",
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.2.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "nanoid": "^5.1.16"
  }
}
