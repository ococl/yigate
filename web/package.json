{
  "name": "yigate-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "update:deps": "npx taze -r -w"
  },
  "dependencies": {
    "antdv-next": "^1.5.0",
    "axios": "^1.19.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.9"
  }
}
