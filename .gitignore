# Binary
yigate
*.exe
*.new
*.out
bin/

# Generated artifacts
/build/
/release/
/tmp/

# 规划/过程文档（对话与任务规划，不纳入版本控制）
/findings.md
/progress.md
/task_plan.md

# Local runtime state
/.local/
.env
.env.*

# Logs and downloaded data
logs/
*.log
geosite.dat
upstream-types.txt
*.tmp

# Go
vendor/
coverage.out
coverage.*
*.coverprofile
*.prof
*.test
__debug_bin*

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
.last_proxy_test_summary

# Frontend (web/)
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local
# auto-imports.d.ts / components.d.ts 需纳入版本控制，供干净构建时 vue-tsc 类型检查使用
web/vite.config.js
web/vite.config.d.ts
web/tsconfig.node.tsbuildinfo

# Embedded webui assets (generated from web/dist at build time)
# 保留占位 index.html（纳入版本控制），确保 `go vet`/`go test`/纯 `go build` 时
# //go:embed all:webui_dist 始终有文件可嵌入；真实前端产物在构建期覆盖此文件。
src/proxy/webui_dist/*
!src/proxy/webui_dist/index.html
