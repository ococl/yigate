root = true

# 默认：UTF-8 + LF + 末尾换行，缩进 2 空格（前端/YAML/JSON/文档）
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go 使用 gofmt 的制表符缩进
[*.go]
indent_style = tab
indent_size = 4

# Makefile 必须使用制表符
[Makefile]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Markdown 行尾空格可用于强制换行，不做裁剪
trim_trailing_whitespace = false

[*.{ps1,sh}]
indent_size = 2
