# 版本控制与流水线元数据
.git
.github
.cnb.yml

# 本地运行状态与规划文档
data
.local
# build/ 里只有 CI 产出的 linux/amd64 二进制需要进入镜像（prebuilt 目标），其余排除。
build/*
!build/yigate-linux-amd64
release
test
docs/superpowers
.codebuddy
.playwright-cli

# 测试与调试产物（镜像内仅需源码）
**/*_test.go
**/*.log
**/*.prof
**/coverage.*
**/__pycache__
**/*.pyc
**/__debug_bin*
**/*.orig
**/*.rej
**/*.bak

# 密钥与环境变量（构建期不应进入镜像层）
.env
.env.*
**/*.pem
**/*.key

# 前端依赖与本地产物（镜像内重新安装/构建）
web/node_modules
web/dist
src/proxy/webui_dist/assets
src/proxy/webui_dist/favicon.svg
